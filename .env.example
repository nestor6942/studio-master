# ==============================================================================
# V-STUDIO PRO - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_USER=vstudio
POSTGRES_PASSWORD=vstudio_secret_password
POSTGRES_DB=vstudio_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vstudio:vstudio_secret_password@localhost:5432/vstudio_db

# Cache & Queues (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# AI Auto-Captions Service (faster-whisper)
AI_CAPTIONS_SERVICE_URL=http://localhost:8001
WHISPER_MODEL=base
COMPUTE_TYPE=int8

# Render Service & Storage (S3 / Cloudflare R2 / Local Storage)
RENDER_OUTPUT_DIR=./exports
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vstudio-renders
R2_ENDPOINT=
CDN_PUBLIC_URL=http://localhost:3000/exports

# Web Editor
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AI_CAPTIONS_URL=http://localhost:8001

# Social Media Publishing APIs (Optional - for live publishing)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

